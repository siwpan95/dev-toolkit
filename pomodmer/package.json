{
  "name": "pomodmer",
  "version": "2.2.0",
  "description": "Cordis 内核 + 本地 Web UI 的番茄钟计时器（Pomodoro timer）",
  "main": "src/pom.mjs",
  "scripts": {
    "start": "node src/pom.mjs",
    "pom": "node src/pom.mjs",
    "demo": "node src/demo.mjs",
    "gen": "node src/cli.mjs",
    "smoke": "node src/_smoke.mjs && node src/_smoke_pom.mjs",
    "sync:kit": "node tools/sync-table-kit.mjs",
    "check:kit": "node tools/sync-table-kit.mjs --check",
    "icon": "node electron/make-icon.mjs",
    "electron": "node electron/start.mjs",
    "smoke:ui": "node tools/ui-smoke.mjs",
    "bench:export": "node tools/bench-export.mjs",
    "verify": "node src/_smoke.mjs && node src/_smoke_pom.mjs && node tools/ui-smoke.mjs",
    "check:xlsx": "node tools/check-xlsx-lo.mjs",
    "verify:full": "node src/_smoke.mjs && node src/_smoke_pom.mjs && node tools/ui-smoke.mjs && node tools/check-xlsx-lo.mjs"
  },
  "keywords": [
    "pomodoro",
    "cordis",
    "timer"
  ],
  "author": "siwpan",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@cordisjs/plugin-loader": "^1.0.0-rc.7",
    "@cordisjs/plugin-logger-console": "^1.0.0",
    "cordis": "^4.0.0-rc.10"
  },
  "devDependencies": {
    "electron": "^44.4.5"
  }
}
